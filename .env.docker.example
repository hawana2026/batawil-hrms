# Compose-only values (not read by the app directly).
# Usage: cp .env.docker.example .env.docker
#        edit the password, then:
#        docker compose --env-file .env.docker up -d --build

# Required. Use a long URL-safe value or percent-encode reserved characters
# because it becomes part of DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Local evaluation defaults (HTTP, no secure cookie, no HSTS).
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
APP_PORT=3000
TRUST_PROXY=0

# Production behind an HTTPS reverse proxy:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://hrms.example.com
# TRUST_PROXY=1

# Used only by the one-time setup command. Leave the password empty so the
# CLI generates one and prints it once to the terminal.
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=مدير النظام
ADMIN_EMAIL=
ADMIN_PASSWORD=
