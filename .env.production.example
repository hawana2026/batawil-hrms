# BATAWIL HRMS - production environment
# Usage:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   openssl rand -hex 32   # use the output as POSTGRES_PASSWORD
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Never commit .env.production. The database password must stay URL-safe
# (hex or letters/digits) because it is embedded in DATABASE_URL.

# Public hostname without scheme. DNS A/AAAA record must already point to this server.
SITE_DOMAIN=hrms.example.com

# Contact address for Let's Encrypt certificate expiry notices.
ACME_EMAIL=admin@example.com

# Required: long random value, e.g. output of: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value

# Business timezone used for "today" calculations and attendance dates.
TZ=Asia/Aden

# Optional session tuning (defaults shown).
# SESSION_IDLE_MINUTES=45
# SESSION_ABSOLUTE_HOURS=12
# SESSION_REMEMBER_DAYS=7

# The initial administrator is NOT configured here for the data migration path.
# After importing the real database, run reset-admin inside the app container to
# generate a fresh temporary password:
#   docker compose -f docker-compose.prod.yml --env-file .env.production \
#     exec app node dist/server/src/cli/reset-admin.js --username admin
