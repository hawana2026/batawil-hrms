# ===== BATAWIL HRMS - Phase 1 =====
# Copy this file to .env and adjust for your environment.
# Never commit .env or real secrets.

NODE_ENV=development
PORT=3000

# Exact public origin of the UI (used for CSRF origin checks and secure cookies).
PUBLIC_ORIGIN=http://localhost:3000

# Database driver:
#   pglite   = embedded PostgreSQL for local development only (no server needed)
#   postgres = a real PostgreSQL server (required in production)
DB_DRIVER=pglite

# Used when DB_DRIVER=pglite
PGLITE_DIR=./.data/pglite

# Used when DB_DRIVER=postgres
# DATABASE_URL=postgres://batawil:CHANGE_ME@localhost:5432/batawil
# Optional schema used as search_path for this app (keep the URL free of options).
# DATABASE_SCHEMA=
# DATABASE_SSL accepts: disable | require | no-verify
# DATABASE_SSL=disable

# Sessions
SESSION_IDLE_MINUTES=45
SESSION_ABSOLUTE_HOURS=12
SESSION_REMEMBER_DAYS=7

# Set to 1 when running behind a trusted reverse proxy (Caddy/Nginx) that sets X-Forwarded-*.
TRUST_PROXY=0

# Initial administrator (used only by: npm run setup)
# Leave ADMIN_PASSWORD empty to generate a strong password and print it once.
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=مدير النظام
ADMIN_EMAIL=
ADMIN_PASSWORD=
